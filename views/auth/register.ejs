<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="card auth-card shadow border-0">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="brand-badge bg-primary text-white rounded-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
            <i class="bi bi-receipt-cutoff"></i>
          </div>
          <h3 class="fw-bold text-dark mb-1">Create Account</h3>
          <p class="text-muted small">Start managing your business bills, items, and taxes</p>
        </div>

        <% if (hasGoogleAuth) { %>
          <div class="d-grid mb-3">
            <a href="/auth/google" class="btn btn-google shadow-sm">
              <svg class="me-2" width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              Sign Up with Google
            </a>
          </div>

          <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1">
            <span class="px-2 text-muted small text-uppercase">Or fill manual details</span>
            <hr class="flex-grow-1">
          </div>
        <% } %>

        <form action="/auth/register" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">Full Name / Business Owner <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Ramesh Sharma" required>
          </div>

          <div class="mb-3">
            <label for="phone" class="form-label">Phone Number</label>
            <input type="tel" class="form-control" id="phone" name="phone" placeholder="e.g. 9876543210">
            <div class="form-text">Used for instant mobile login.</div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="e.g. business@gmail.com">
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="password" name="password" minlength="6" placeholder="Min. 6 characters" required>
            </div>
            <div class="col-md-6 mb-4">
              <label for="confirm_password" class="form-label">Confirm Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="confirm_password" name="confirm_password" minlength="6" placeholder="Re-enter password" required>
            </div>
          </div>

          <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
              <i class="bi bi-person-check me-1"></i> Register Business Account
            </button>
          </div>
        </form>

        <div class="text-center text-muted small mt-4">
          Already have an account? <a href="/auth/login" class="text-primary fw-semibold text-decoration-none">Sign In here</a>
        </div>

        <div class="text-center mt-3 pt-3 border-top">
          <div class="text-muted small mb-1">Need help or support?</div>
          <div class="dropdown d-inline-block">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1 fw-semibold dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-headset text-primary me-1"></i> Contact Support (+91 9672847747)
            </button>
            <ul class="dropdown-menu dropdown-menu-center shadow border-0 text-start py-2 mt-1" style="font-size: 0.85rem; min-width: 230px; border-radius: 10px;">
              <li class="dropdown-header small text-uppercase fw-bold text-muted">Choose App to Open</li>
              <li>
                <a class="dropdown-item py-2 d-flex align-items-center" href="whatsapp://send?phone=919672847747&text=Hi%20RACE%20FINANCE%20Support,%20I%20need%20assistance.">
                  <i class="bi bi-whatsapp text-success fs-5 me-2"></i>
                  <div>
                    <div class="fw-semibold">WhatsApp App</div>
                    <small class="text-muted">Open WhatsApp application</small>
                  </div>
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 d-flex align-items-center" href="tel:+919672847747">
                  <i class="bi bi-telephone-fill text-primary fs-5 me-2"></i>
                  <div>
                    <div class="fw-semibold">Phone / Dialer App</div>
                    <small class="text-muted">Dial +91 9672847747</small>
                  </div>
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 d-flex align-items-center" href="sms:+919672847747?body=Hi%20RACE%20FINANCE%20Support">
                  <i class="bi bi-chat-dots-fill text-info fs-5 me-2"></i>
                  <div>
                    <div class="fw-semibold">SMS / Messaging App</div>
                    <small class="text-muted">Open Messages application</small>
                  </div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
