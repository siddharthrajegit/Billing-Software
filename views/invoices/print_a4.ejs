<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sales Record - <%= invoice.invoice_number %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background-color: #f1f5f9;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: #111;
      margin: 0;
      padding: 20px 0;
    }
    .print-wrapper {
      max-width: 210mm;
      margin: 0 auto;
      background: #fff;
      padding: 15mm;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      border: 1px solid #cbd5e1;
    }
    .tax-invoice-box {
      border: 1px solid #000;
    }
    .bordered-table th, .bordered-table td {
      border: 1px solid #000 !important;
      padding: 4px 6px;
      font-size: 11px;
    }
    .bordered-table th {
      background-color: #f8fafc;
      font-weight: 600;
    }
    @media print {
      body {
        background-color: #fff !important;
        padding: 0 !important;
      }
      .print-wrapper {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        max-width: 100% !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- Floating Print Toolbar -->
  <div class="container mb-3 no-print" style="max-width: 210mm;">
    <div class="d-flex justify-content-between align-items-center bg-dark text-white p-2 rounded shadow-sm">
      <div class="d-flex align-items-center">
        <i class="bi bi-printer fs-5 me-2 text-warning"></i>
        <span class="fw-semibold">Print Digital Record (<%= invoice.invoice_number %>)</span>
      </div>
      <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary btn-sm px-3 fw-bold">
          <i class="bi bi-printer me-1"></i> Print / Save PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-light btn-sm px-3">
          Close
        </button>
      </div>
    </div>
  </div>

  <div class="print-wrapper">
    <div class="tax-invoice-box">
      <!-- Record Title Bar -->
      <div class="text-center py-1 border-bottom border-dark bg-light">
        <h5 class="fw-bold mb-0 text-uppercase letter-spacing-1" style="font-size: 14px;">
          <%= invoice.is_gst_bill ? (invoice.type === 'purchase' ? 'DIGITAL PURCHASE RECORD' : 'DIGITAL SALES RECORD') : (invoice.type === 'purchase' ? 'PURCHASE RECORD' : 'SALES RECORD') %>
        </h5>
        <div class="small text-muted" style="font-size: 10px;">(Digital Reference Copy)</div>
      </div>

      <!-- Seller & Invoice Header -->
      <div class="row g-0 border-bottom border-dark">
        <!-- Left: Seller Info -->
        <div class="col-7 p-2 border-end border-dark">
          <div class="d-flex align-items-center mb-1">
            <% if (firm.logo_path) { %>
              <img src="<%= firm.logo_path %>" alt="Logo" class="me-2" style="max-height: 40px; max-width: 80px; object-fit: contain;">
            <% } %>
            <div>
              <h6 class="fw-bold mb-0 text-uppercase" style="font-size: 13px;"><%= firm.name %></h6>
            </div>
          </div>
          <div style="font-size: 11px; line-height: 1.3;">
            <% if (firm.address) { %><div><%= firm.address %></div><% } %>
            <div><%= [firm.city, firm.state].filter(Boolean).join(', ') %> <%= firm.pincode ? '- ' + firm.pincode : '' %></div>
            <% if (firm.phone) { %><div><strong>Phone:</strong> <%= firm.phone %></div><% } %>
            <% if (firm.email) { %><div><strong>Email:</strong> <%= firm.email %></div><% } %>
            <% if (firm.gstin) { %><div><strong>GSTIN:</strong> <%= firm.gstin %></div><% } %>
            <% if (firm.pan) { %><div><strong>PAN:</strong> <%= firm.pan %></div><% } %>
            <div><strong>State:</strong> <%= firm.state || '--' %> (Code: <%= firm.state_code || '--' %>)</div>
          </div>
        </div>

        <!-- Right: Invoice Metadata -->
        <div class="col-5 p-2" style="font-size: 11px; line-height: 1.4;">
          <table class="table table-borderless table-sm mb-0" style="font-size: 11px;">
            <tr>
              <td class="p-0 fw-bold" style="width: 45%;">Record No:</td>
              <td class="p-0 font-monospace fw-bold"><%= invoice.invoice_number %></td>
            </tr>
            <tr>
              <td class="p-0 fw-bold">Record Date:</td>
              <td class="p-0"><%= invoice.invoice_date %></td>
            </tr>
            <% if (invoice.due_date) { %>
              <tr>
                <td class="p-0 fw-bold">Due Date:</td>
                <td class="p-0"><%= invoice.due_date %></td>
              </tr>
            <% } %>
            <tr>
              <td class="p-0 fw-bold">Payment Mode:</td>
              <td class="p-0 text-uppercase"><%= invoice.payment_mode || 'Cash' %></td>
            </tr>
            <tr>
              <td class="p-0 fw-bold">Place of Supply:</td>
              <td class="p-0"><%= invoice.party_state || firm.state || '--' %> (<%= invoice.party_state_code || firm.state_code || '--' %>)</td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Buyer Details (Billed To) -->
      <div class="p-2 border-bottom border-dark" style="font-size: 11px; line-height: 1.3;">
        <div class="fw-bold text-uppercase mb-1" style="font-size: 11px;">
          <%= invoice.type === 'purchase' ? 'Billed From (Supplier Details):' : 'Billed To (Customer Details):' %>
        </div>
        <div class="row">
          <div class="col-7">
            <div class="fw-bold fs-6"><%= invoice.party_name %></div>
            <% if (invoice.party_address) { %><div><%= invoice.party_address %></div><% } %>
            <% if (invoice.party_phone) { %><div><strong>Phone:</strong> <%= invoice.party_phone %></div><% } %>
          </div>
          <div class="col-5">
            <% if (invoice.party_gstin) { %><div><strong>GSTIN / UIN:</strong> <%= invoice.party_gstin %></div><% } %>
            <div><strong>State:</strong> <%= invoice.party_state || '--' %> (Code: <%= invoice.party_state_code || '--' %>)</div>
          </div>
        </div>
      </div>

      <!-- Line Items Table -->
      <table class="table bordered-table mb-0">
        <thead>
          <tr class="text-center">
            <th style="width: 30px;">#</th>
            <th class="text-start">Description of Goods / Services</th>
            <th style="width: 70px;">HSN/SAC</th>
            <th style="width: 45px;">Qty</th>
            <th style="width: 45px;">Unit</th>
            <th style="width: 65px;" class="text-end">Rate (₹)</th>
            <th style="width: 50px;" class="text-end">Disc %</th>
            <% if (invoice.is_gst_bill) { %>
              <th style="width: 70px;" class="text-end">Taxable (₹)</th>
              <% if (invoice.is_interstate) { %>
                <th style="width: 70px;" class="text-end">IGST (₹)</th>
              <% } else { %>
                <th style="width: 55px;" class="text-end">CGST (₹)</th>
                <th style="width: 55px;" class="text-end">SGST (₹)</th>
              <% } %>
            <% } %>
            <th style="width: 75px;" class="text-end">Amount (₹)</th>
          </tr>
        </thead>
        <tbody>
          <% if (invoice.items && invoice.items.length > 0) { %>
            <% invoice.items.forEach((item, index) => { %>
              <tr>
                <td class="text-center"><%= index + 1 %></td>
                <td>
                  <strong><%= item.item_name %></strong>
                </td>
                <td class="text-center font-monospace"><%= item.hsn_code || '--' %></td>
                <td class="text-center"><%= item.quantity %></td>
                <td class="text-center"><%= item.unit %></td>
                <td class="text-end"><%= parseFloat(item.rate).toFixed(2) %></td>
                <td class="text-end"><%= item.discount_percent > 0 ? item.discount_percent + '%' : '--' %></td>
                <% if (invoice.is_gst_bill) { %>
                  <td class="text-end"><%= parseFloat(item.taxable_amount).toFixed(2) %></td>
                  <% if (invoice.is_interstate) { %>
                    <td class="text-end"><%= parseFloat(item.igst_amount).toFixed(2) %></td>
                  <% } else { %>
                    <td class="text-end"><%= parseFloat(item.cgst_amount).toFixed(2) %></td>
                    <td class="text-end"><%= parseFloat(item.sgst_amount).toFixed(2) %></td>
                  <% } %>
                <% } %>
                <td class="text-end fw-bold"><%= parseFloat(item.total_amount).toFixed(2) %></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>

      <!-- Total & Calculation Summary -->
      <div class="row g-0 border-top border-dark">
        <!-- Left: Bank Details & Amount in Words -->
        <div class="col-7 p-2 border-end border-dark" style="font-size: 11px;">
          <% if (firm.bank_name || firm.bank_account_no || firm.upi_id) { %>
            <div class="mb-2">
              <strong class="text-uppercase" style="font-size: 10px;">Bank Account Details:</strong>
              <div>Bank: <strong><%= firm.bank_name || '--' %></strong> (<%= firm.bank_branch || '' %>)</div>
              <div>A/C No: <strong><%= firm.bank_account_no || '--' %></strong></div>
              <div>IFSC Code: <strong><%= firm.bank_ifsc || '--' %></strong></div>
              <% if (firm.upi_id) { %><div>UPI ID: <strong><%= firm.upi_id %></strong></div><% } %>
            </div>
          <% } %>

          <% if (invoice.terms) { %>
            <div class="mt-2 text-muted" style="font-size: 10px;">
              <strong>Terms & Conditions:</strong>
              <div><%= invoice.terms %></div>
            </div>
          <% } %>
        </div>

        <!-- Right: Summary Totals -->
        <div class="col-5 p-2" style="font-size: 11px;">
          <table class="table table-borderless table-sm mb-0">
            <tr>
              <td class="p-1">Taxable Amount:</td>
              <td class="p-1 text-end fw-semibold">₹ <%= parseFloat(invoice.taxable_amount || invoice.subtotal).toFixed(2) %></td>
            </tr>
            <% if (invoice.discount_amount > 0) { %>
              <tr>
                <td class="p-1 text-danger">Discount:</td>
                <td class="p-1 text-end text-danger">- ₹ <%= parseFloat(invoice.discount_amount).toFixed(2) %></td>
              </tr>
            <% } %>
            <% if (invoice.is_gst_bill && invoice.tax_amount > 0) { %>
              <% if (invoice.is_interstate) { %>
                <tr>
                  <td class="p-1">IGST (Integrated Tax):</td>
                  <td class="p-1 text-end">₹ <%= parseFloat(invoice.igst_amount || invoice.tax_amount).toFixed(2) %></td>
                </tr>
              <% } else { %>
                <tr>
                  <td class="p-1">CGST:</td>
                  <td class="p-1 text-end">₹ <%= parseFloat(invoice.cgst_amount).toFixed(2) %></td>
                </tr>
                <tr>
                  <td class="p-1">SGST:</td>
                  <td class="p-1 text-end">₹ <%= parseFloat(invoice.sgst_amount).toFixed(2) %></td>
                </tr>
              <% } %>
            <% } %>
            <% if (invoice.round_off != 0) { %>
              <tr>
                <td class="p-1">Round Off:</td>
                <td class="p-1 text-end">₹ <%= parseFloat(invoice.round_off).toFixed(2) %></td>
              </tr>
            <% } %>
            <tr class="border-top border-dark">
              <td class="p-1 fw-bold fs-6">Grand Total:</td>
              <td class="p-1 text-end fw-bold fs-6">₹ <%= parseFloat(invoice.grand_total).toFixed(2) %></td>
            </tr>
            <tr>
              <td class="p-1 text-success">Received / Paid:</td>
              <td class="p-1 text-end text-success fw-semibold">₹ <%= parseFloat(invoice.paid_amount).toFixed(2) %></td>
            </tr>
            <tr>
              <td class="p-1 text-danger fw-bold">Balance Due:</td>
              <td class="p-1 text-end text-danger fw-bold">₹ <%= parseFloat(invoice.balance_due).toFixed(2) %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Signatures Footer -->
      <div class="row g-0 border-top border-dark">
        <div class="col-7 p-2 border-end border-dark text-muted" style="font-size: 10px;">
          <div>Customer / Recipient Signature</div>
          <div style="height: 35px;"></div>
        </div>
        <div class="col-5 p-2 text-end" style="font-size: 11px;">
          <div class="fw-bold">For <%= firm.name %></div>
          <div style="height: 25px;"></div>
          <div class="small fw-semibold">Authorized Signatory</div>
        </div>
      </div>

      <!-- Digital Reference Utility Note -->
      <div class="p-1 text-center border-top border-dark bg-light text-muted" style="font-size: 8.5px;">
        * Note: This document is a digital business record generated for internal management and accounting data entry. It is not an official tax invoice.
      </div>
    </div>
  </div>

</body>
</html>
