<%- include('../partials/header') %>

<!-- Top Action Toolbar -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 no-print">
  <div>
    <a href="<%= invoice.type === 'purchase' ? '/purchases' : '/sales' %>" class="text-decoration-none text-muted small">&larr; Back to <%= invoice.type === 'purchase' ? 'Purchases' : 'Sales' %></a>
    <h3 class="fw-bold mb-0 mt-1">
      <%= invoice.type === 'purchase' ? 'Purchase Record' : 'Sales Record' %>: <span class="font-monospace text-primary"><%= invoice.invoice_number %></span>
    </h3>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <% if (invoice.balance_due > 0) { %>
      <a href="/payments/create?party_id=<%= invoice.party_id %>&invoice_id=<%= invoice.id %>&type=<%= invoice.type === 'purchase' ? 'payment_out' : 'payment_in' %>" class="btn btn-success shadow-sm">
        <i class="bi bi-cash-stack me-1"></i> Record Payment
      </a>
    <% } %>
    <a href="/invoices/download/<%= invoice.id %>" class="btn btn-primary shadow-sm">
      <i class="bi bi-download me-1"></i> Download Record
    </a>
    <a href="/invoices/edit/<%= invoice.id %>" class="btn btn-outline-warning shadow-sm">
      <i class="bi bi-pencil-square me-1"></i> Edit Record
    </a>
    <a href="/invoices/print/<%= invoice.id %>" target="_blank" class="btn btn-outline-secondary shadow-sm">
      <i class="bi bi-printer me-1"></i> Print Record
    </a>
    <form action="/invoices/delete/<%= invoice.id %>" method="POST" class="d-inline form-delete-confirm" data-confirm-message="Are you sure you want to delete this record? Item inventory stock will be restored automatically.">
      <button type="submit" class="btn btn-outline-danger" title="Delete Record">
        <i class="bi bi-trash me-1"></i> Delete
      </button>
    </form>
  </div>
</div>

<!-- Record Card Preview -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body p-4 p-md-5">
    <!-- Header: Business Info & Record Info -->
    <div class="row border-bottom pb-4 mb-4">
      <div class="col-md-7">
        <div class="d-flex align-items-center mb-3">
          <% if (firm.logo_path) { %>
            <img src="<%= firm.logo_path %>" alt="<%= firm.name %>" class="rounded border p-1 me-3 bg-white" height="50">
          <% } %>
          <div>
            <h4 class="fw-bold text-dark mb-0"><%= firm.name %></h4>
            <% if (firm.gstin) { %>
              <div class="small text-muted font-monospace">GSTIN: <strong><%= firm.gstin %></strong></div>
            <% } %>
          </div>
        </div>
        <div class="small text-muted">
          <% if (firm.address) { %><div><%= firm.address %></div><% } %>
          <% if (firm.city || firm.state) { %><div><%= [firm.city, firm.state].filter(Boolean).join(', ') %> - <%= firm.pincode || '' %></div><% } %>
          <% if (firm.phone) { %><div>Phone: <%= firm.phone %></div><% } %>
          <% if (firm.email) { %><div>Email: <%= firm.email %></div><% } %>
        </div>
      </div>

      <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <h5 class="fw-bold text-uppercase text-primary mb-2">
          <%= invoice.is_gst_bill ? (invoice.type === 'purchase' ? 'GST Purchase Record' : 'GST Sales Record') : (invoice.type === 'purchase' ? 'Purchase Record' : 'Sales Record') %>
        </h5>
        <div class="small">
          <div><strong>Record No:</strong> <span class="font-monospace"><%= invoice.invoice_number %></span></div>
          <div><strong>Record Date:</strong> <%= invoice.invoice_date %></div>
          <% if (invoice.due_date) { %><div><strong>Due Date:</strong> <%= invoice.due_date %></div><% } %>
          <div><strong>Payment Mode:</strong> <%= (invoice.payment_mode || 'Cash').toUpperCase() %></div>
          <div class="mt-2">
            <strong>Status:</strong>
            <% if (invoice.payment_status === 'paid') { %>
              <span class="badge badge-status badge-status-paid">Paid</span>
            <% } else if (invoice.payment_status === 'partial') { %>
              <span class="badge badge-status badge-status-partial">Partial</span>
            <% } else { %>
              <span class="badge badge-status badge-status-unpaid">Unpaid</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Billed To Section -->
    <div class="row border-bottom pb-4 mb-4">
      <div class="col-12">
        <h6 class="fw-bold text-uppercase text-secondary small mb-2">
          <%= invoice.type === 'purchase' ? 'Party (Supplier / Vendor)' : 'Party (Customer / Client)' %>
        </h6>
        <div class="fw-bold text-dark fs-6"><%= invoice.party_name %></div>
        <div class="small text-muted">
          <% if (invoice.party_phone) { %><div>Phone: <%= invoice.party_phone %></div><% } %>
          <% if (invoice.party_gstin) { %><div>GSTIN: <span class="font-monospace fw-medium"><%= invoice.party_gstin %></span></div><% } %>
          <% if (invoice.party_address) { %><div>Address: <%= invoice.party_address %></div><% } %>
          <% if (invoice.party_state) { %><div>State: <%= invoice.party_state %> (<%= invoice.party_state_code || '--' %>)</div><% } %>
        </div>
      </div>
    </div>

    <!-- Line Items Table -->
    <div class="table-responsive mb-4">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th class="text-center" style="width: 40px;">#</th>
            <th>Item Description</th>
            <th class="text-center">HSN/SAC</th>
            <th class="text-center">Qty</th>
            <th class="text-end">Rate (₹)</th>
            <% if (invoice.is_gst_bill) { %>
              <th class="text-center">GST %</th>
              <th class="text-end">Tax (₹)</th>
            <% } %>
            <th class="text-end">Total (₹)</th>
          </tr>
        </thead>
        <tbody>
          <% if (invoice.items && invoice.items.length > 0) { %>
            <% invoice.items.forEach((item, index) => { %>
              <tr>
                <td class="text-center text-muted small"><%= index + 1 %></td>
                <td>
                  <div class="fw-semibold text-dark"><%= item.item_name %></div>
                  <% if (item.description) { %>
                    <div class="text-muted small"><%= item.description %></div>
                  <% } %>
                </td>
                <td class="text-center font-monospace small"><%= item.hsn_code || '--' %></td>
                <td class="text-center">
                  <strong><%= parseFloat(item.quantity).toFixed(2) %></strong>
                  <span class="text-muted small"><%= item.unit || 'PCS' %></span>
                </td>
                <td class="text-end">₹ <%= parseFloat(item.price).toFixed(2) %></td>
                <% if (invoice.is_gst_bill) { %>
                  <td class="text-center small"><%= parseFloat(item.tax_rate || 0) %>%</td>
                  <td class="text-end text-muted small">₹ <%= parseFloat(item.tax_amount || 0).toFixed(2) %></td>
                <% } %>
                <td class="text-end fw-bold">₹ <%= parseFloat(item.total_amount).toFixed(2) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="<%= invoice.is_gst_bill ? 8 : 6 %>" class="text-center text-muted py-4">No items listed in this record.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Totals Summary & Terms -->
    <div class="row g-4">
      <div class="col-md-6">
        <% if (invoice.notes) { %>
          <div class="mb-3">
            <h6 class="fw-bold small text-uppercase text-muted mb-1">Notes / Remarks</h6>
            <p class="small text-muted mb-0"><%= invoice.notes %></p>
          </div>
        <% } %>

        <% if (firm.terms_and_conditions) { %>
          <div class="mb-3">
            <h6 class="fw-bold small text-uppercase text-muted mb-1">Terms & Conditions</h6>
            <div class="small text-muted" style="white-space: pre-line;"><%= firm.terms_and_conditions %></div>
          </div>
        <% } %>

        <!-- Digital Reference Record Notice -->
        <div class="alert alert-light border small text-muted mt-3 mb-0">
          <i class="bi bi-info-circle me-1 text-primary"></i>
          <strong>Digital Reference Record:</strong> This document is created for internal business bookkeeping and accounting data entry. Use these figures for filing returns or sharing with your tax professional.
        </div>
      </div>

      <div class="col-md-6">
        <div class="card bg-light border-0 p-3">
          <div class="d-flex justify-content-between py-1 border-bottom">
            <span class="text-muted small">Taxable Subtotal:</span>
            <span class="fw-medium">₹ <%= parseFloat(invoice.taxable_amount || invoice.subtotal).toFixed(2) %></span>
          </div>

          <% if (invoice.discount_amount > 0) { %>
            <div class="d-flex justify-content-between py-1 border-bottom text-danger">
              <span class="small">Discount:</span>
              <span>- ₹ <%= parseFloat(invoice.discount_amount).toFixed(2) %></span>
            </div>
          <% } %>

          <% if (invoice.is_gst_bill && invoice.tax_amount > 0) { %>
            <% if (invoice.is_interstate) { %>
              <div class="d-flex justify-content-between py-1 border-bottom text-muted small">
                <span>IGST (Integrated Tax):</span>
                <span>₹ <%= parseFloat(invoice.igst_amount || invoice.tax_amount).toFixed(2) %></span>
              </div>
            <% } else { %>
              <div class="d-flex justify-content-between py-1 border-bottom text-muted small">
                <span>CGST:</span>
                <span>₹ <%= parseFloat(invoice.cgst_amount).toFixed(2) %></span>
              </div>
              <div class="d-flex justify-content-between py-1 border-bottom text-muted small">
                <span>SGST:</span>
                <span>₹ <%= parseFloat(invoice.sgst_amount).toFixed(2) %></span>
              </div>
            <% } %>
          <% } %>

          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="fw-bold fs-6">Grand Total:</span>
            <span class="fw-bold fs-5 text-primary">₹ <%= parseFloat(invoice.grand_total).toFixed(2) %></span>
          </div>

          <div class="d-flex justify-content-between py-1">
            <span class="text-success small fw-semibold">Amount Paid:</span>
            <span class="fw-semibold text-success">₹ <%= parseFloat(invoice.paid_amount).toFixed(2) %></span>
          </div>

          <div class="d-flex justify-content-between py-1">
            <span class="text-danger small fw-semibold">Balance Due:</span>
            <span class="fw-bold text-danger">₹ <%= parseFloat(invoice.balance_due).toFixed(2) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
