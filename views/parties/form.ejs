<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold mb-0 text-dark">
          <i class="bi bi-person-lines-fill me-2 text-primary"></i>
          <%= party ? 'Edit Party Details' : 'Add New Customer / Supplier' %>
        </h4>
        <a href="/parties" class="btn btn-outline-secondary btn-sm">Cancel</a>
      </div>

      <div class="card-body p-4">
        <form action="<%= party ? '/parties/edit/' + party.id : '/parties/create' %>" method="POST">
          <!-- Type & Name -->
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="type" class="form-label">Party Type <span class="text-danger">*</span></label>
              <select class="form-select" id="type" name="type" required>
                <option value="customer" <%= (party ? party.type === 'customer' : defaultType === 'customer') ? 'selected' : '' %>>Customer (Buyer)</option>
                <option value="supplier" <%= (party ? party.type === 'supplier' : defaultType === 'supplier') ? 'selected' : '' %>>Supplier (Vendor)</option>
                <option value="both" <%= (party && party.type === 'both') ? 'selected' : '' %>>Both (Customer & Supplier)</option>
              </select>
            </div>
            <div class="col-md-8">
              <label for="name" class="form-label">Party / Customer Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Acme Corporation or Rajesh Gupta" value="<%= party ? party.name : '' %>" required autofocus>
            </div>
          </div>

          <!-- Contact & Tax Info -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="phone" class="form-label">Mobile / Phone (10 Digits)</label>
              <input type="tel" class="form-control font-monospace" id="phone" name="phone" placeholder="10-digit mobile number" maxlength="10" minlength="10" pattern="[0-9]{10}" inputmode="numeric" value="<%= party ? (party.phone || '') : '' %>" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
              <div class="form-text small" style="font-size: 0.75rem;">Exact 10 numeric digits</div>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="e.g. party@example.com" value="<%= party ? (party.email || '') : '' %>">
            </div>
            <div class="col-md-6">
              <label for="gstin" class="form-label">GSTIN (15 Characters)</label>
              <input type="text" class="form-control font-monospace text-uppercase" id="gstin" name="gstin" placeholder="15-character GSTIN" maxlength="15" minlength="15" pattern="[0-9A-Z]{15}" value="<%= party ? (party.gstin || '') : '' %>" oninput="this.value = this.value.toUpperCase().replace(/[^0-9A-Z]/g, '')">
              <div class="form-text small" style="font-size: 0.75rem;">Exact 15 letters & numbers</div>
            </div>
            <div class="col-md-6">
              <label for="pan" class="form-label">PAN Number (Optional)</label>
              <input type="text" class="form-control font-monospace text-uppercase" id="pan" name="pan" placeholder="e.g. ABCDE1234F" maxlength="10" value="<%= party ? (party.pan || '') : '' %>" oninput="this.value = this.value.toUpperCase().replace(/[^0-9A-Z]/g, '')">
            </div>
          </div>

          <!-- Address & State -->
          <div class="row g-3 mb-3">
            <div class="col-12">
              <label for="billing_address" class="form-label">Billing Address</label>
              <textarea class="form-control" id="billing_address" name="billing_address" rows="2" placeholder="Street address, building, locality..."><%= party ? (party.billing_address || '') : '' %></textarea>
            </div>
            <div class="col-md-4">
              <label for="city" class="form-label">City</label>
              <input type="text" class="form-control" id="city" name="city" placeholder="e.g. Pune" value="<%= party ? (party.city || '') : '' %>">
            </div>
            <div class="col-md-4">
              <label for="partyStateSelect" class="form-label">State / UT</label>
              <select class="form-select" id="partyStateSelect" name="state">
                <option value="">-- Select State --</option>
                <% gstStates.forEach(st => { %>
                  <option value="<%= st.name %>" data-code="<%= st.code %>" <%= (party && (party.state === st.name || party.state_code === st.code)) ? 'selected' : '' %>>
                    <%= st.name %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-2">
              <label for="partyStateCodeInput" class="form-label">State Code</label>
              <input type="text" class="form-control font-monospace bg-light fw-bold text-center text-primary" id="partyStateCodeInput" name="state_code" placeholder="00" value="<%= party ? (party.state_code || '') : '' %>" readonly title="Auto-filled from state">
            </div>
            <div class="col-md-2">
              <label for="pincode" class="form-label">Pincode</label>
              <input type="text" class="form-control" id="pincode" name="pincode" placeholder="e.g. 411001" maxlength="6" value="<%= party ? (party.pincode || '') : '' %>" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
            </div>
          </div>

          <!-- Opening Balance -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="opening_balance" class="form-label">Opening Balance (₹)</label>
              <input type="number" class="form-control" id="opening_balance" name="opening_balance" step="any" placeholder="0.00" value="<%= party ? party.opening_balance : '0' %>">
              <div class="form-text">Positive for amount to receive (Debit), negative for amount to pay (Credit).</div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/parties" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 shadow-sm">
              <i class="bi bi-check2-circle me-1"></i> <%= party ? 'Update Party' : 'Save Party' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const pStateSelect = document.getElementById('partyStateSelect');
  const pStateCodeInput = document.getElementById('partyStateCodeInput');
  const gstinInput = document.getElementById('gstin');

  if (pStateSelect && pStateCodeInput) {
    pStateSelect.addEventListener('change', function() {
      const selected = pStateSelect.options[pStateSelect.selectedIndex];
      pStateCodeInput.value = selected ? (selected.dataset.code || '') : '';
    });
  }

  if (gstinInput && pStateSelect) {
    gstinInput.addEventListener('input', function() {
      if (this.value.length >= 2) {
        const prefix = this.value.slice(0, 2);
        const opt = Array.from(pStateSelect.options).find(o => o.dataset.code === prefix);
        if (opt) {
          pStateSelect.value = opt.value;
          if (pStateCodeInput) pStateCodeInput.value = prefix;
        }
      }
    });
  }
</script>

<%- include('../partials/footer') %>
