      </div>
    </main>

    <% if (typeof user !== 'undefined' && user) { %>
      <footer class="footer mt-auto py-3 bg-white border-top text-muted small">
        <div class="container-fluid px-lg-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center">
            <span>Vyapar Lite &copy; <%= new Date().getFullYear() %> — Smart Small Business Accounting</span>
            <span>Active Firm: <strong class="text-dark"><%= activeFirm ? activeFirm.name : 'None' %></strong></span>
          </div>
        </div>
      </footer>
    </div> <!-- /app-main-wrapper -->
  </div> <!-- /app-layout -->
  <% } else { %>
  </div> <!-- /container -->
</main>
<% } %>

<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Main App JS -->
<script src="/js/app.js"></script>
</body>
</html>
