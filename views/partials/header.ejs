<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - RACE FINANCE' : 'RACE FINANCE - Billing & Accounting' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<% if (typeof user !== 'undefined' && user) { %>
<div class="app-layout">
  <!-- Mobile Sidebar Backdrop Overlay -->
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <!-- Vertical Sidebar Navigation -->
  <aside class="app-sidebar p-3 text-white" id="appSidebar">
    <!-- Sidebar Header & Brand Logo -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
      <a class="text-decoration-none text-white d-flex align-items-center fw-bold fs-5" href="/dashboard">
        <div class="brand-badge bg-primary text-white rounded-3 me-2 d-flex align-items-center justify-content-center shadow-sm">
          <i class="bi bi-receipt-cutoff"></i>
        </div>
        <span>RACE <span class="text-primary-light">FINANCE</span></span>
      </a>
      <button type="button" class="btn-close btn-close-white d-lg-none btn-sidebar-toggle" aria-label="Close Sidebar"></button>
    </div>

    <!-- Active Firm Switcher Card -->
    <% if (typeof userFirms !== 'undefined' && userFirms && userFirms.length > 0) { %>
      <div class="dropdown mb-3">
        <div class="sidebar-firm-card dropdown-toggle d-flex align-items-center justify-content-between" role="button" data-bs-toggle="dropdown" aria-expanded="false">
          <div class="d-flex align-items-center text-truncate me-2">
            <i class="bi bi-buildings fs-5 text-warning me-2"></i>
            <div class="text-truncate">
              <div class="fw-bold text-white small text-truncate"><%= activeFirm ? activeFirm.name : 'Select Firm' %></div>
              <div class="text-muted" style="font-size: 0.72rem;"><%= activeFirm && activeFirm.gstin ? activeFirm.gstin : (activeFirm && activeFirm.state ? activeFirm.state : 'Switch Business') %></div>
            </div>
          </div>
          <i class="bi bi-chevron-expand text-muted small"></i>
        </div>

        <ul class="dropdown-menu dropdown-menu-dark shadow border-secondary w-100">
          <li class="dropdown-header text-uppercase text-secondary small fw-bold">Switch Business Firm</li>
          <% userFirms.forEach(firm => { %>
            <li>
              <form action="/firms/switch/<%= firm.id %>" method="POST" class="m-0">
                <button type="submit" class="dropdown-item py-2 d-flex align-items-center justify-content-between <%= (activeFirm && activeFirm.id === firm.id) ? 'active bg-primary' : '' %>">
                  <span class="text-truncate me-2"><%= firm.name %></span>
                  <% if (firm.is_default) { %>
                    <span class="badge bg-secondary ms-1 small">Default</span>
                  <% } %>
                </button>
              </form>
            </li>
          <% }); %>
          <li><hr class="dropdown-divider border-secondary"></li>
          <li>
            <a class="dropdown-item text-primary-light d-flex align-items-center py-2" href="/firms/create">
              <i class="bi bi-plus-circle me-2"></i> Register New Firm
            </a>
          </li>
          <li>
            <a class="dropdown-item d-flex align-items-center py-2" href="/firms">
              <i class="bi bi-gear me-2"></i> Manage All Firms
            </a>
          </li>
        </ul>
      </div>
    <% } %>

    <!-- Quick CTA Button -->
    <a href="/sales/create" class="btn btn-success btn-sm w-100 mb-3 shadow-sm d-flex align-items-center justify-content-center py-2 fw-semibold">
      <i class="bi bi-plus-circle-fill me-1"></i> New Sale Bill
    </a>

    <!-- Navigation Menu Items -->
    <div class="sidebar-nav flex-grow-1">
      <ul class="nav flex-column mb-auto">
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>" href="/dashboard">
            <i class="bi bi-grid"></i> Dashboard
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'sales' ? 'active' : '' %>" href="/sales">
            <i class="bi bi-cart-check"></i> Sales Invoices
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'purchases' ? 'active' : '' %>" href="/purchases">
            <i class="bi bi-bag-plus"></i> Purchase Bills
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'items' ? 'active' : '' %>" href="/items">
            <i class="bi bi-box-seam"></i> Items & Inventory
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'parties' ? 'active' : '' %>" href="/parties">
            <i class="bi bi-people"></i> Parties & Customers
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'payments' ? 'active' : '' %>" href="/payments">
            <i class="bi bi-cash-stack"></i> Payments
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'reports' ? 'active' : '' %>" href="/reports">
            <i class="bi bi-bar-chart-line"></i> Reports & GST
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'backup' ? 'active' : '' %>" href="/backup">
            <i class="bi bi-cloud-arrow-up"></i> Backup & Cloud
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'settings' ? 'active' : '' %>" href="/settings">
            <i class="bi bi-gear"></i> Settings
          </a>
        </li>
      </ul>
    </div>

    <!-- User Profile & Footer Section inside Sidebar -->
    <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
      <div class="dropdown">
        <div class="d-flex align-items-center justify-content-between p-2 rounded sidebar-nav" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
          <div class="d-flex align-items-center text-truncate me-2">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="<%= user.name %>" class="rounded-circle me-2" width="28" height="28">
            <% } else { %>
              <i class="bi bi-person-circle fs-5 text-secondary me-2"></i>
            <% } %>
            <div class="text-truncate">
              <div class="fw-semibold text-white small text-truncate"><%= user.name %></div>
              <div class="text-muted" style="font-size: 0.7rem;"><%= user.email || user.phone %></div>
            </div>
          </div>
          <i class="bi bi-three-dots-vertical text-muted"></i>
        </div>
        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-secondary w-100">
          <li><a class="dropdown-item py-2" href="/settings"><i class="bi bi-gear me-2"></i> Settings</a></li>
          <li><a class="dropdown-item py-2" href="/firms"><i class="bi bi-buildings me-2"></i> Business Firms</a></li>
          <li><a class="dropdown-item py-2" href="/backup"><i class="bi bi-cloud-arrow-up me-2"></i> Data Backup</a></li>
          <li><hr class="dropdown-divider border-secondary"></li>
          <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
        </ul>
      </div>
    </div>
  </aside>

  <!-- Main Content Layout Area -->
  <div class="app-main-wrapper">
    <!-- Top Mobile Navbar Header -->
    <header class="d-lg-none bg-dark text-white p-2 px-3 d-flex align-items-center justify-content-between sticky-top shadow-sm">
      <button class="btn btn-outline-light btn-sm btn-sidebar-toggle me-2" type="button" aria-label="Toggle navigation">
        <i class="bi bi-list fs-5"></i>
      </button>
      <div class="fw-bold d-flex align-items-center">
        <span class="badge bg-primary me-1"><i class="bi bi-receipt-cutoff"></i></span>
        <span><%= activeFirm ? activeFirm.name : 'RACE FINANCE' %></span>
      </div>
      <a href="/sales/create" class="btn btn-success btn-sm">
        <i class="bi bi-plus-lg"></i> Bill
      </a>
    </header>

    <main class="py-4 flex-grow-1">
      <div class="<%= typeof fluidContainer !== 'undefined' && fluidContainer ? 'container-fluid px-lg-4' : 'container-fluid px-lg-4' %>">
        <%- include('alerts') %>
<% } else { %>
<!-- Non-Logged In Container (Login, Register, Error Pages) -->
<main class="py-4">
  <div class="container">
    <%- include('alerts') %>
<% } %>
