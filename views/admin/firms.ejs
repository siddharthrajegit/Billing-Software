<%- include('../partials/header') %>

<%- include('_nav') %>

<!-- Filter & Search Toolbar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <form action="/admin/firms" method="GET" class="d-flex align-items-center gap-2 flex-grow-1">
        <div class="input-group input-group-sm" style="max-width: 380px;">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0" placeholder="Search by firm name, GSTIN, owner..." value="<%= search || '' %>">
        </div>
        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Search</button>
        <% if (search) { %>
          <a href="/admin/firms" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Clear</a>
        <% } %>
      </form>
      <span class="badge bg-light text-dark border py-2 px-3">
        Total Businesses: <strong><%= firms.length %></strong>
      </span>
    </div>
  </div>
</div>

<!-- Firms Table -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>Business Firm</th>
          <th>Subscriber / Owner</th>
          <th>GSTIN & State</th>
          <th class="text-center">Bank / UPI</th>
          <th class="text-center">Parties</th>
          <th class="text-center">Items</th>
          <th class="text-center">Invoices</th>
          <th class="text-end px-3">Gross Turnover (₹)</th>
        </tr>
      </thead>
      <tbody>
        <% if (firms && firms.length > 0) { %>
          <% firms.forEach(f => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <% if (f.logo_path) { %>
                    <img src="<%= f.logo_path %>" alt="Logo" class="rounded border p-1 bg-white" width="38" height="38" style="object-fit: contain;">
                  <% } else { %>
                    <div class="rounded-circle bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                      <i class="bi bi-buildings"></i>
                    </div>
                  <% } %>
                  <div>
                    <div class="fw-bold text-dark"><%= f.name %></div>
                    <small class="text-muted"><%= f.city || f.state || 'Local' %></small>
                  </div>
                </div>
              </td>
              <td>
                <div class="small fw-semibold text-dark">
                  <a href="/admin/users/<%= f.user_id %>" class="text-decoration-none text-dark"><%= f.owner_name %></a>
                </div>
                <div class="small text-muted font-monospace"><%= f.owner_phone || f.owner_email %></div>
              </td>
              <td>
                <% if (f.gstin) { %>
                  <div class="font-monospace small text-primary fw-bold"><%= f.gstin %></div>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary small">Non-GST</span>
                <% } %>
                <div class="small text-muted"><%= f.state ? f.state + ' (' + (f.state_code || '--') + ')' : '--' %></div>
              </td>
              <td class="text-center">
                <% if (f.bank_account_no) { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle small" title="Bank Configured">Bank</span>
                <% } %>
                <% if (f.upi_id) { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle small" title="UPI Configured">UPI</span>
                <% } %>
                <% if (!f.bank_account_no && !f.upi_id) { %>
                  <span class="text-muted small">--</span>
                <% } %>
              </td>
              <td class="text-center font-monospace small"><%= f.parties_count %></td>
              <td class="text-center font-monospace small"><%= f.items_count %></td>
              <td class="text-center font-monospace small"><%= f.invoices_count %></td>
              <td class="text-end px-3 fw-bold font-monospace text-dark">
                ₹ <%= parseFloat(f.total_turnover || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              <i class="bi bi-buildings fs-1 d-block mb-2 text-secondary opacity-50"></i>
              No business firms found matching your search.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
