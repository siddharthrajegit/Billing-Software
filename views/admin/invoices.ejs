<%- include('../partials/header') %>

<%- include('_nav') %>

<!-- Filter & Search Toolbar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <form action="/admin/invoices" method="GET" class="d-flex flex-wrap align-items-center gap-2">
      <div class="input-group input-group-sm" style="max-width: 340px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="search" class="form-control border-start-0" placeholder="Search invoice #, party, firm, phone..." value="<%= search || '' %>">
      </div>

      <select name="type" class="form-select form-select-sm" style="max-width: 140px;" onchange="this.form.submit()">
        <option value="">All Types</option>
        <option value="sale" <%= type === 'sale' ? 'selected' : '' %>>Sales Only</option>
        <option value="purchase" <%= type === 'purchase' ? 'selected' : '' %>>Purchases Only</option>
      </select>

      <select name="payment_status" class="form-select form-select-sm" style="max-width: 140px;" onchange="this.form.submit()">
        <option value="">All Statuses</option>
        <option value="paid" <%= payment_status === 'paid' ? 'selected' : '' %>>Paid</option>
        <option value="partial" <%= payment_status === 'partial' ? 'selected' : '' %>>Partial</option>
        <option value="unpaid" <%= payment_status === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
      </select>

      <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Filter</button>
      <% if (search || type || payment_status) { %>
        <a href="/admin/invoices" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Clear</a>
      <% } %>
      <span class="ms-auto badge bg-light text-dark border py-2 px-3">
        Showing <%= invoices.length %> latest invoices
      </span>
    </form>
  </div>
</div>

<!-- Invoices Table -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>Invoice #</th>
          <th>Firm & Subscriber</th>
          <th>Billed Party</th>
          <th>Date</th>
          <th class="text-center">Type</th>
          <th class="text-end">Total Amount (₹)</th>
          <th class="text-end">Balance Due (₹)</th>
          <th class="text-center">Status</th>
          <th class="text-end px-3">Inspect Bill</th>
        </tr>
      </thead>
      <tbody>
        <% if (invoices && invoices.length > 0) { %>
          <% invoices.forEach(inv => { %>
            <tr>
              <td class="font-monospace fw-bold text-primary">
                <a href="/invoices/download/<%= inv.id %>" target="_blank" class="text-decoration-none"><%= inv.invoice_number %></a>
              </td>
              <td>
                <div class="fw-semibold text-dark"><%= inv.firm_name %></div>
                <small class="text-muted font-monospace"><%= inv.owner_name %> (<%= inv.owner_phone || inv.owner_email %>)</small>
              </td>
              <td>
                <div class="fw-semibold text-dark"><%= inv.party_name %></div>
                <% if (inv.party_phone) { %><small class="text-muted font-monospace"><%= inv.party_phone %></small><% } %>
              </td>
              <td class="small text-muted font-monospace"><%= inv.invoice_date %></td>
              <td class="text-center">
                <% if (inv.type === 'sale') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">SALE</span>
                <% } else { %>
                  <span class="badge bg-info-subtle text-info border border-info-subtle">PURCHASE</span>
                <% } %>
              </td>
              <td class="text-end fw-bold font-monospace text-dark">₹ <%= parseFloat(inv.grand_total).toFixed(2) %></td>
              <td class="text-end font-monospace <%= parseFloat(inv.balance_due) > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                ₹ <%= parseFloat(inv.balance_due).toFixed(2) %>
              </td>
              <td class="text-center">
                <% if (inv.payment_status === 'paid') { %>
                  <span class="badge bg-success-subtle text-success px-2 py-1">PAID</span>
                <% } else if (inv.payment_status === 'partial') { %>
                  <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1">PARTIAL</span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger px-2 py-1">UNPAID</span>
                <% } %>
              </td>
              <td class="text-end px-3">
                <a href="/invoices/download/<%= inv.id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3" target="_blank" title="View & Download Bill">
                  <i class="bi bi-eye me-1"></i> View Bill
                </a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="9" class="text-center py-5 text-muted">
              <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
              No invoices found matching your filter criteria.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
