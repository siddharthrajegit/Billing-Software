<%- include('../partials/header') %>

<%- include('_nav') %>

<!-- Top Back Action & User Title -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div class="d-flex align-items-center gap-3">
    <a href="/admin/users" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
      <i class="bi bi-arrow-left me-1"></i> All Subscribers
    </a>
    <div>
      <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
        <span><%= targetUser.name %></span>
        <% if (targetUser.role === 'admin') { %>
          <span class="badge bg-warning text-dark px-2 py-1 fs-6">ADMIN</span>
        <% } else { %>
          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1 fs-6">SUBSCRIBER</span>
        <% } %>
        <% if (targetUser.status === 'active') { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">ACTIVE</span>
        <% } else { %>
          <span class="badge bg-danger text-white px-2 py-1 fs-6">SUSPENDED</span>
        <% } %>
      </h4>
      <div class="text-muted small">
        Subscriber ID: <strong class="font-monospace text-dark">#<%= targetUser.id %></strong> |
        Phone: <strong class="font-monospace text-dark"><%= targetUser.phone || 'N/A' %></strong> |
        Email: <strong class="text-dark"><%= targetUser.email || 'N/A' %></strong> |
        Joined: <span class="font-monospace"><%= new Date(targetUser.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
      </div>
    </div>
  </div>

  <!-- Account Action Controls -->
  <% if (targetUser.id !== user.id) { %>
    <div class="d-flex align-items-center gap-2">
      <form action="/admin/users/<%= targetUser.id %>/status" method="POST" class="m-0">
        <button type="submit" class="btn btn-sm <%= targetUser.status === 'active' ? 'btn-outline-danger' : 'btn-outline-success' %> rounded-pill px-3">
          <i class="bi <%= targetUser.status === 'active' ? 'bi-lock-fill' : 'bi-unlock-fill' %> me-1"></i>
          <%= targetUser.status === 'active' ? 'Suspend Account' : 'Activate Account' %>
        </button>
      </form>

      <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3" onclick="openResetPasswordModal('<%= targetUser.id %>', '<%= targetUser.name %>')">
        <i class="bi bi-key-fill me-1"></i> Reset Password
      </button>
    </div>
  <% } %>
</div>

<!-- Subscriber Financial & Business Overview KPI Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
      <div class="text-muted small fw-bold text-uppercase">Total Billed Sales</div>
      <h3 class="fw-bold text-success mb-0 mt-1">₹ <%= parseFloat(financials.total_sales || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h3>
      <small class="text-muted"><%= financials.total_invoices || 0 %> Total Bills Logged</small>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
      <div class="text-muted small fw-bold text-uppercase">Total Purchases</div>
      <h3 class="fw-bold text-primary mb-0 mt-1">₹ <%= parseFloat(financials.total_purchases || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h3>
      <small class="text-muted">Procurement Volume</small>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
      <div class="text-muted small fw-bold text-uppercase">Customer Outstanding (Due)</div>
      <h3 class="fw-bold text-danger mb-0 mt-1">₹ <%= parseFloat(financials.total_due || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h3>
      <small class="text-muted">Receivable from parties</small>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
      <div class="text-muted small fw-bold text-uppercase">Registered Assets</div>
      <div class="d-flex justify-content-between align-items-baseline mt-1">
        <span class="fw-bold text-dark fs-5"><%= firms.length %>/2 Firms</span>
        <span class="badge bg-secondary"><%= items.length %> Items / <%= parties.length %> Parties</span>
      </div>
      <small class="text-muted">Database records under user</small>
    </div>
  </div>
</div>

<!-- 360-Degree Deep Information Tab Navigation -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: hidden;">
  <div class="card-header bg-white border-bottom p-3">
    <ul class="nav nav-tabs card-header-tabs" id="subscriberTab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold py-2 px-3 text-dark" id="firms-tab" data-bs-toggle="tab" data-bs-target="#firms-content" type="button" role="tab">
          <i class="bi bi-buildings-fill text-primary me-2"></i> Registered Firms (<%= firms.length %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2 px-3 text-dark" id="parties-tab" data-bs-toggle="tab" data-bs-target="#parties-content" type="button" role="tab">
          <i class="bi bi-people-fill text-success me-2"></i> Customers & Parties (<%= parties.length %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2 px-3 text-dark" id="items-tab" data-bs-toggle="tab" data-bs-target="#items-content" type="button" role="tab">
          <i class="bi bi-box-seam-fill text-warning me-2"></i> Inventory Items (<%= items.length %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2 px-3 text-dark" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoices-content" type="button" role="tab">
          <i class="bi bi-receipt-cutoff text-danger me-2"></i> All Invoices & Bills (<%= invoices.length %>)
        </button>
      </li>
    </ul>
  </div>

  <div class="card-body p-4">
    <div class="tab-content" id="subscriberTabContent">

      <!-- TAB 1: Registered Business Firms -->
      <div class="tab-pane fade show active" id="firms-content" role="tabpanel">
        <% if (firms && firms.length > 0) { %>
          <div class="row g-4">
            <% firms.forEach((f, idx) => { %>
              <div class="col-lg-6">
                <div class="card border border-2 shadow-none h-100 rounded-3">
                  <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge bg-primary">Firm #<%= idx + 1 %></span>
                      <strong class="text-dark fs-6"><%= f.name %></strong>
                      <% if (f.is_default) { %>
                        <span class="badge bg-secondary small">Default</span>
                      <% } %>
                    </div>
                    <span class="badge bg-white text-dark border font-monospace">ID: <%= f.id %></span>
                  </div>
                  <div class="card-body p-3 small">
                    <div class="row g-2 mb-3">
                      <div class="col-sm-6">
                        <span class="text-muted d-block">GSTIN Number:</span>
                        <strong class="text-dark font-monospace"><%= f.gstin || 'Non-GST' %></strong>
                      </div>
                      <div class="col-sm-6">
                        <span class="text-muted d-block">PAN:</span>
                        <strong class="text-dark font-monospace"><%= f.pan || 'None' %></strong>
                      </div>
                      <div class="col-sm-6">
                        <span class="text-muted d-block">State & Code:</span>
                        <span class="text-dark"><%= f.state ? f.state + ' (Code ' + (f.state_code || '--') + ')' : 'None' %></span>
                      </div>
                      <div class="col-sm-6">
                        <span class="text-muted d-block">Contact:</span>
                        <span class="text-dark"><%= f.phone || '--' %> <%= f.email ? '| ' + f.email : '' %></span>
                      </div>
                      <div class="col-12">
                        <span class="text-muted d-block">Address:</span>
                        <span class="text-dark"><%= f.address || '--' %>, <%= f.city || '' %> <%= f.pincode ? '- ' + f.pincode : '' %></span>
                      </div>
                    </div>

                    <!-- Bank & UPI -->
                    <div class="p-2 bg-light rounded-2 mb-3">
                      <div class="fw-bold text-dark mb-1"><i class="bi bi-bank me-1"></i> Banking & Payment Info:</div>
                      <div>Bank: <strong><%= f.bank_name || 'Not Configured' %></strong></div>
                      <div>Account #: <span class="font-monospace"><strong><%= f.bank_account_no || 'None' %></strong></span> | IFSC: <span class="font-monospace"><%= f.bank_ifsc || 'None' %></span></div>
                      <div>UPI ID: <span class="font-monospace text-primary"><strong><%= f.upi_id || 'None' %></strong></span></div>
                    </div>

                    <!-- Images: Logo & Signature -->
                    <div class="row g-2 text-center pt-2 border-top">
                      <div class="col-6">
                        <span class="text-muted d-block small mb-1">Company Logo:</span>
                        <% if (f.logo_path) { %>
                          <a href="<%= f.logo_path %>" target="_blank">
                            <img src="<%= f.logo_path %>" alt="Logo" class="rounded border p-1 bg-white" style="max-height: 48px; max-width: 100px; object-fit: contain;">
                          </a>
                        <% } else { %>
                          <span class="text-muted small italic">No Logo Uploaded</span>
                        <% } %>
                      </div>
                      <div class="col-6">
                        <span class="text-muted d-block small mb-1">Digital Signature:</span>
                        <% if (f.signature_path) { %>
                          <a href="<%= f.signature_path %>" target="_blank">
                            <img src="<%= f.signature_path %>" alt="Signature" class="rounded border p-1 bg-white" style="max-height: 48px; max-width: 100px; object-fit: contain;">
                          </a>
                        <% } else { %>
                          <span class="text-muted small italic">No Signature Uploaded</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                  <div class="card-footer bg-white py-2 px-3 d-flex justify-content-between small text-muted">
                    <span><%= f.items_count %> Items | <%= f.parties_count %> Parties</span>
                    <span>Turnover: <strong class="text-success">₹ <%= parseFloat(f.total_turnover || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></strong></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-buildings fs-1 d-block mb-2 text-secondary opacity-50"></i>
            This subscriber has not registered any business firms yet.
          </div>
        <% } %>
      </div>

      <!-- TAB 2: Customers & Parties Directory -->
      <div class="tab-pane fade" id="parties-content" role="tabpanel">
        <% if (parties && parties.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
              <thead class="table-dark">
                <tr>
                  <th>Party Name</th>
                  <th>Firm</th>
                  <th>Type</th>
                  <th>Contact Info</th>
                  <th>GSTIN / PAN</th>
                  <th>State</th>
                  <th class="text-end">Balance (₹)</th>
                </tr>
              </thead>
              <tbody>
                <% parties.forEach(p => { %>
                  <tr>
                    <td>
                      <strong class="text-dark"><%= p.name %></strong>
                      <% if (p.billing_address) { %>
                        <div class="text-muted" style="font-size: 0.75rem;"><%= p.billing_address %></div>
                      <% } %>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= p.firm_name %></span></td>
                    <td>
                      <span class="badge <%= p.type === 'customer' ? 'bg-primary-subtle text-primary' : (p.type === 'supplier' ? 'bg-warning-subtle text-warning-emphasis' : 'bg-info-subtle text-info') %>">
                        <%= (p.type || 'customer').toUpperCase() %>
                      </span>
                    </td>
                    <td class="font-monospace">
                      <div><%= p.phone || '--' %></div>
                      <div class="text-muted"><%= p.email || '' %></div>
                    </td>
                    <td class="font-monospace">
                      <div><%= p.gstin || '--' %></div>
                      <div class="text-muted"><%= p.pan || '' %></div>
                    </td>
                    <td><%= p.state ? p.state + ' (' + (p.state_code || '') + ')' : '--' %></td>
                    <td class="text-end fw-bold font-monospace <%= p.opening_balance > 0 ? 'text-success' : (p.opening_balance < 0 ? 'text-danger' : 'text-muted') %>">
                      ₹ <%= parseFloat(p.opening_balance || 0).toFixed(2) %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
            No customers or parties registered by this subscriber.
          </div>
        <% } %>
      </div>

      <!-- TAB 3: Inventory Items Catalog -->
      <div class="tab-pane fade" id="items-content" role="tabpanel">
        <% if (items && items.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
              <thead class="table-dark">
                <tr>
                  <th>Item / Product Name</th>
                  <th>Firm</th>
                  <th>Item Code / HSN</th>
                  <th>Tax Rate</th>
                  <th class="text-end">Sale Price (₹)</th>
                  <th class="text-end">Purchase Price (₹)</th>
                  <th class="text-center">Current Stock</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach(it => { %>
                  <tr>
                    <td>
                      <strong class="text-dark"><%= it.name %></strong>
                      <% if (it.description) { %>
                        <div class="text-muted" style="font-size: 0.75rem;"><%= it.description %></div>
                      <% } %>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= it.firm_name %></span></td>
                    <td class="font-monospace">
                      <div>Code: <%= it.item_code || '--' %></div>
                      <div class="text-muted">HSN: <%= it.hsn_code || '--' %></div>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border"><%= it.tax_rate %>%</span>
                      <small class="text-muted d-block"><%= it.tax_inclusive ? 'Incl.' : 'Excl.' %></small>
                    </td>
                    <td class="text-end fw-bold font-monospace text-success">
                      ₹ <%= parseFloat(it.sale_price || 0).toFixed(2) %>
                    </td>
                    <td class="text-end font-monospace text-muted">
                      ₹ <%= parseFloat(it.purchase_price || 0).toFixed(2) %>
                    </td>
                    <td class="text-center font-monospace">
                      <span class="badge <%= it.current_stock <= it.low_stock_threshold ? 'bg-danger text-white' : 'bg-success-subtle text-success' %> px-2 py-1">
                        <%= it.current_stock %> <%= it.unit || 'PCS' %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary opacity-50"></i>
            No inventory items created by this subscriber.
          </div>
        <% } %>
      </div>

      <!-- TAB 4: Invoices Ledger -->
      <div class="tab-pane fade" id="invoices-content" role="tabpanel">
        <% if (invoices && invoices.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
              <thead class="table-dark">
                <tr>
                  <th>Invoice #</th>
                  <th>Firm</th>
                  <th>Party Name</th>
                  <th>Date</th>
                  <th class="text-center">Type</th>
                  <th class="text-end">Total Amount (₹)</th>
                  <th class="text-end">Balance Due (₹)</th>
                  <th class="text-center">Status</th>
                  <th class="text-end px-3">View Bill</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(inv => { %>
                  <tr>
                    <td class="font-monospace fw-bold text-primary">
                      <a href="/invoices/download/<%= inv.id %>" target="_blank" class="text-decoration-none"><%= inv.invoice_number %></a>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= inv.firm_name %></span></td>
                    <td>
                      <strong class="text-dark"><%= inv.party_name %></strong>
                      <% if (inv.party_phone) { %><div class="text-muted font-monospace" style="font-size: 0.75rem;"><%= inv.party_phone %></div><% } %>
                    </td>
                    <td class="text-muted font-monospace"><%= inv.invoice_date %></td>
                    <td class="text-center">
                      <span class="badge <%= inv.type === 'sale' ? 'bg-success-subtle text-success' : 'bg-info-subtle text-info' %>">
                        <%= (inv.type || 'sale').toUpperCase() %>
                      </span>
                    </td>
                    <td class="text-end fw-bold font-monospace text-dark">
                      ₹ <%= parseFloat(inv.grand_total).toFixed(2) %>
                    </td>
                    <td class="text-end font-monospace <%= parseFloat(inv.balance_due) > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                      ₹ <%= parseFloat(inv.balance_due).toFixed(2) %>
                    </td>
                    <td class="text-center">
                      <% if (inv.payment_status === 'paid') { %>
                        <span class="badge bg-success-subtle text-success px-2 py-1">PAID</span>
                      <% } else if (inv.payment_status === 'partial') { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1">PARTIAL</span>
                      <% } else { %>
                        <span class="badge bg-danger-subtle text-danger px-2 py-1">UNPAID</span>
                      <% } %>
                    </td>
                    <td class="text-end px-3">
                      <a href="/invoices/download/<%= inv.id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3" target="_blank" title="Inspect & View Bill">
                        <i class="bi bi-eye me-1"></i> View Bill
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
            No invoices generated by this subscriber.
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<!-- Modal: Admin Reset Password -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
      <div class="modal-header bg-warning text-dark border-0 py-3">
        <h5 class="modal-title fw-bold" id="resetPasswordModalLabel"><i class="bi bi-key-fill me-2"></i> Reset Subscriber Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="resetPasswordForm" method="POST">
        <div class="modal-body p-4">
          <p class="text-muted small mb-3">
            Overriding password for subscriber: <strong id="resetUserName" class="text-dark"></strong>
          </p>
          <div class="mb-3">
            <label class="form-label fw-bold small text-dark">New Password <span class="text-danger">*</span></label>
            <input type="password" name="new_password" class="form-control" placeholder="Enter new password (min 6 chars)" required minlength="6">
          </div>
        </div>
        <div class="modal-footer border-0 bg-light">
          <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-check-circle me-1"></i> Update Password
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openResetPasswordModal(userId, userName) {
    document.getElementById('resetUserName').textContent = userName;
    document.getElementById('resetPasswordForm').action = `/admin/users/${userId}/reset-password`;
    const modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
    modal.show();
  }
</script>

<%- include('../partials/footer') %>
