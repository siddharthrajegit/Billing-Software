<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= payment.type === 'payment_in' ? 'Payment Receipt' : 'Payment Voucher' %> - <%= payment.payment_number %> | RACE FINANCE</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style>
    :root {
      --theme-primary: <%= payment.type === 'payment_in' ? '#065f46' : '#1e3a8a' %>;
      --theme-accent: <%= payment.type === 'payment_in' ? '#059669' : '#2563eb' %>;
      --theme-light: <%= payment.type === 'payment_in' ? '#ecfdf5' : '#eff6ff' %>;
      --theme-border: <%= payment.type === 'payment_in' ? '#a7f3d0' : '#bfdbfe' %>;
    }

    body {
      background-color: #f1f5f9;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      color: #1e293b;
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    /* Top Static Action Toolbar (Does not move with scroll) */
    .top-action-bar {
      position: relative;
      background: #0f172a;
      color: #fff;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .slip-container {
      max-width: 190mm;
      margin: 1.5rem auto 3rem auto;
      padding: 0 1rem;
    }

    .slip-paper {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
      border: 1px solid #e2e8f0;
      overflow: hidden;
      position: relative;
    }

    .slip-top-strip {
      height: 8px;
      background: linear-gradient(90deg, var(--theme-primary), var(--theme-accent));
    }

    .slip-inner {
      padding: 2.2rem;
    }

    .firm-name {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--theme-primary);
      letter-spacing: -0.02em;
    }

    .slip-title-badge {
      display: inline-block;
      background: var(--theme-light);
      color: var(--theme-primary);
      border: 1.5px solid var(--theme-border);
      padding: 0.35rem 1rem;
      border-radius: 8px;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .info-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1rem 1.15rem;
      height: 100%;
    }

    .info-card-header {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--theme-accent);
      margin-bottom: 0.4rem;
    }

    .amount-hero-box {
      background: var(--theme-light);
      border: 2px dashed var(--theme-border);
      border-radius: 12px;
      padding: 1.25rem;
      text-align: center;
      margin: 1.5rem 0;
    }

    .amount-display {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--theme-primary);
      letter-spacing: -0.02em;
    }

    .sign-box {
      border-top: 1.5px solid #cbd5e1;
      min-width: 170px;
      text-align: center;
      padding-top: 0.4rem;
    }

    @media print {
      body {
        background-color: #ffffff !important;
        padding: 0 !important;
      }
      .no-print, .top-action-bar, .modal-backdrop, .modal {
        display: none !important;
      }
      .slip-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .slip-paper {
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
      }
      .slip-inner {
        padding: 8mm !important;
      }
    }
  </style>
</head>
<body>

  <!-- Top Sticky Action Toolbar -->
  <header class="top-action-bar no-print">
    <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <!-- Left: Back link and Slip Badge -->
      <div class="d-flex align-items-center gap-3">
        <% if (payment.party_id) { %>
          <a href="/parties/ledger/<%= payment.party_id %>" class="btn btn-outline-light btn-sm d-flex align-items-center rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Ledger
          </a>
        <% } else { %>
          <a href="/payments" class="btn btn-outline-light btn-sm d-flex align-items-center rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Payments
          </a>
        <% } %>
        <div>
          <div class="fw-bold fs-6 d-flex align-items-center gap-2">
            <span><%= payment.type === 'payment_in' ? 'Payment Receipt' : 'Payment Voucher' %>: <span class="font-monospace text-warning"><%= payment.payment_number %></span></span>
            <span class="badge <%= payment.type === 'payment_in' ? 'bg-success' : 'bg-danger' %> rounded-pill small">
              <%= payment.type === 'payment_in' ? 'RECEIVED' : 'PAID' %>
            </span>
          </div>
          <small class="text-white-50"><%= payment.party_name %> | ₹ <%= parseFloat(payment.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></small>
        </div>
      </div>

      <!-- Right: Actions -->
      <div class="d-flex flex-wrap align-items-center gap-2">
        <!-- 1. Download PDF Button -->
        <button id="btnDownloadSlipPdf" class="btn btn-primary btn-sm fw-semibold rounded-pill px-3 shadow-sm d-flex align-items-center">
          <i class="bi bi-download me-1"></i> Download Slip
        </button>

        <!-- 2. Print Button -->
        <button onclick="window.print()" class="btn btn-secondary btn-sm fw-semibold rounded-pill px-3 shadow-sm d-flex align-items-center">
          <i class="bi bi-printer me-1"></i> Print Slip
        </button>

        <!-- 3. Direct Send to WhatsApp Button -->
        <% 
          const cleanPhone = (payment.party_phone || '').replace(/[^0-9]/g, '');
          const waPhone = cleanPhone.length === 10 ? '91' + cleanPhone : cleanPhone;
          const isRec = payment.type === 'payment_in';
          const waText = encodeURIComponent(
            `*${isRec ? 'Payment Receipt' : 'Payment Voucher'} from ${firm.name}*\n` +
            `Voucher No: *${payment.payment_number}*\n` +
            `Date: ${payment.payment_date}\n` +
            `Amount: *₹ ${parseFloat(payment.amount).toFixed(2)}*\n` +
            `Payment Mode: *${(payment.payment_mode || 'Cash').toUpperCase()}*\n` +
            (payment.reference_no ? `Ref / Txn No: ${payment.reference_no}\n` : '') +
            `\nDear ${payment.party_name}, thank you for your transaction!`
          );
          const waUrl = `whatsapp://send?phone=${waPhone}&text=${waText}`;
        %>
        <a href="<%= waUrl %>" class="btn btn-success btn-sm fw-semibold rounded-pill px-3 shadow-sm d-flex align-items-center">
          <i class="bi bi-whatsapp me-1"></i> WhatsApp Slip
        </a>

        <!-- Delete Payment -->
        <form action="/payments/delete/<%= payment.id %>" method="POST" class="d-inline m-0 form-delete-confirm" data-confirm-message="Are you sure you want to delete this payment slip? Party balances will be adjusted automatically.">
          <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
            <i class="bi bi-trash me-1"></i> Delete
          </button>
        </form>
      </div>
    </div>
  </header>

  <!-- Main Slip Paper Area -->
  <div class="slip-container">
    <div class="slip-paper" id="paymentSlipArea">
      <!-- Top Colored Accent Bar -->
      <div class="slip-top-strip"></div>

      <div class="slip-inner">
        <!-- 1. Header: Firm Profile & Receipt Meta -->
        <div class="row align-items-start mb-4 pb-3 border-bottom">
          <div class="col-7">
            <div class="d-flex align-items-center mb-2">
              <% if (firm.logo_path) { %>
                <img src="<%= firm.logo_path %>" alt="<%= firm.name %>" class="rounded border p-1 me-3 bg-white" style="max-height: 48px; max-width: 85px; object-fit: contain;">
              <% } %>
              <div>
                <h3 class="firm-name mb-0"><%= firm.name %></h3>
                <% if (firm.gstin) { %>
                  <div class="small fw-semibold text-muted font-monospace mt-1">
                    GSTIN: <span class="text-dark"><%= firm.gstin %></span>
                  </div>
                <% } %>
              </div>
            </div>
            <div class="small text-muted pe-3" style="font-size: 0.82rem; line-height: 1.45;">
              <% if (firm.address) { %><div><%= firm.address %></div><% } %>
              <% if (firm.city || firm.state) { %><div><%= [firm.city, firm.state].filter(Boolean).join(', ') %> - <%= firm.pincode || '' %></div><% } %>
              <% if (firm.phone) { %><div><i class="bi bi-telephone text-secondary me-1"></i> <%= firm.phone %></div><% } %>
              <% if (firm.email) { %><div><i class="bi bi-envelope text-secondary me-1"></i> <%= firm.email %></div><% } %>
            </div>
          </div>

          <div class="col-5 text-end">
            <div class="slip-title-badge mb-2">
              <%= payment.type === 'payment_in' ? 'PAYMENT RECEIPT' : 'PAYMENT VOUCHER' %>
            </div>
            <div class="small text-muted" style="font-size: 0.84rem;">
              <div><strong>Voucher No:</strong> <span class="font-monospace fw-bold text-dark"><%= payment.payment_number %></span></div>
              <div><strong>Date:</strong> <span class="text-dark"><%= payment.payment_date %></span></div>
              <div><strong>Payment Mode:</strong> <span class="badge bg-light text-dark border text-uppercase fw-semibold"><%= payment.payment_mode || 'Cash' %></span></div>
              <% if (payment.reference_no) { %>
                <div><strong>Ref / Txn ID:</strong> <span class="font-monospace text-dark"><%= payment.reference_no %></span></div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- 2. Party Information Card -->
        <div class="info-card mb-3">
          <div class="info-card-header">
            <i class="bi bi-person-check me-1"></i> <%= payment.type === 'payment_in' ? 'Received From (Customer)' : 'Paid To (Supplier / Vendor)' %>
          </div>
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="fw-bold text-dark fs-5"><%= payment.party_name %></div>
              <div class="small text-muted mt-1" style="font-size: 0.82rem; line-height: 1.45;">
                <% if (payment.party_phone) { %><div><strong>Phone:</strong> <%= payment.party_phone %></div><% } %>
                <% if (payment.party_gstin) { %><div><strong>GSTIN:</strong> <span class="font-monospace fw-medium text-dark"><%= payment.party_gstin %></span></div><% } %>
                <% if (payment.party_address) { %><div><strong>Address:</strong> <%= payment.party_address %></div><% } %>
                <% if (payment.party_state) { %><div><strong>State:</strong> <%= payment.party_state %> <% if (payment.party_state_code) { %>(Code: <%= payment.party_state_code %>)<% } %></div><% } %>
              </div>
            </div>
            <% if (payment.party_id) { %>
              <a href="/parties/ledger/<%= payment.party_id %>" class="btn btn-outline-primary btn-sm no-print">
                <i class="bi bi-journal-text me-1"></i> View Full Ledger
              </a>
            <% } %>
          </div>
        </div>

        <!-- 3. Amount Hero Display -->
        <div class="amount-hero-box">
          <div class="small text-uppercase fw-bold text-muted mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
            <%= payment.type === 'payment_in' ? 'Total Amount Received' : 'Total Amount Paid' %>
          </div>
          <div class="amount-display">
            ₹ <%= parseFloat(payment.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="small text-muted mt-1 font-monospace">
            Payment Mode: <strong class="text-uppercase text-dark"><%= payment.payment_mode || 'Cash' %></strong>
            <% if (payment.reference_no) { %> | Ref: <strong class="text-dark"><%= payment.reference_no %></strong><% } %>
          </div>
        </div>

        <!-- 4. Notes & Linked Settlement Details -->
        <div class="row g-3 mb-4">
          <div class="col-md-7">
            <div class="p-3 border rounded bg-light h-100">
              <div class="text-uppercase fw-bold text-muted mb-1" style="font-size: 0.72rem;">Transaction Notes / Description:</div>
              <div class="small text-dark" style="font-size: 0.82rem;">
                <%= payment.notes || 'Payment recorded and allocated against account ledger balance.' %>
              </div>
              <% if (payment.linked_invoice_number) { %>
                <div class="mt-2 pt-2 border-top small text-primary">
                  <i class="bi bi-link-45deg"></i> Linked to Bill: <strong><%= payment.linked_invoice_number %></strong>
                </div>
              <% } %>
            </div>
          </div>

          <div class="col-md-5">
            <div class="p-3 border rounded bg-white h-100 text-center d-flex flex-column justify-content-between">
              <div class="small text-muted" style="font-size: 0.75rem;">
                Digitally generated transaction receipt.<br>
                Valid without physical signature.
              </div>
              <div class="mt-3">
                <% if (firm.signature_path) { %>
                  <img src="<%= firm.signature_path %>" alt="Signature" style="max-height: 38px; max-width: 120px;" class="mb-1">
                <% } else { %>
                  <div style="height: 32px;"></div>
                <% } %>
                <div class="sign-box">
                  <small class="fw-bold text-dark d-block" style="font-size: 0.78rem;">For <%= firm.name %></small>
                  <small class="text-muted" style="font-size: 0.7rem;">Authorized Signatory</small>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('btnDownloadSlipPdf').addEventListener('click', function () {
      const element = document.getElementById('paymentSlipArea');
      const voucherNo = '<%= payment.payment_number %>';
      const btn = this;
      const originalText = btn.innerHTML;

      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Generating PDF...';
      btn.disabled = true;

      const opt = {
        margin: [8, 8, 8, 8],
        filename: `PaymentSlip_${voucherNo}.pdf`,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };

      html2pdf().set(opt).from(element).save().then(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }).catch(err => {
        console.error('PDF error:', err);
        btn.innerHTML = originalText;
        btn.disabled = false;
        window.print();
      });
    });
  </script>
</body>
</html>
