<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-10">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold mb-0 text-dark">
          <i class="bi bi-building-gear me-2 text-primary"></i>
          <%= firm ? 'Edit Business Firm' : 'Register New Business Firm' %>
        </h4>
        <a href="/firms" class="btn btn-outline-secondary btn-sm">Cancel</a>
      </div>

      <div class="card-body p-4">
        <form action="<%= firm ? '/firms/edit/' + firm.id : '/firms/create' %>" method="POST" enctype="multipart/form-data">
          <!-- Section 1: Basic Information -->
          <h5 class="fw-semibold text-primary border-bottom pb-2 mb-3">1. Business Profile</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="name" class="form-label">Business / Firm Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Sharma Enterprises" value="<%= firm ? firm.name : '' %>" required>
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label">Business Phone / Mobile</label>
              <input type="tel" class="form-control" id="phone" name="phone" placeholder="e.g. 9876543210" value="<%= firm ? (firm.phone || '') : '' %>">
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">Business Email</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="e.g. info@sharmaenterprises.com" value="<%= firm ? (firm.email || '') : '' %>">
            </div>
            <div class="col-md-6">
              <label for="gstin" class="form-label">GSTIN (Optional)</label>
              <input type="text" class="form-control font-monospace text-uppercase" id="gstin" name="gstin" placeholder="e.g. 27AAAAA0000A1Z5" maxlength="15" value="<%= firm ? (firm.gstin || '') : '' %>">
              <div class="form-text">Leave blank if non-GST / unregistered.</div>
            </div>
            <div class="col-md-6">
              <label for="pan" class="form-label">PAN Number (Optional)</label>
              <input type="text" class="form-control font-monospace text-uppercase" id="pan" name="pan" placeholder="e.g. ABCDE1234F" maxlength="10" value="<%= firm ? (firm.pan || '') : '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Business Logo <small class="text-muted">(JPG/PNG/WebP, Max 2MB)</small></label>
              <input type="file" class="form-control" name="logo" accept=".jpg,.jpeg,.png,.webp">
              <% if (firm && firm.logo_path) { %>
                <div class="mt-2 d-flex align-items-center">
                  <img src="<%= firm.logo_path %>" alt="Current Logo" class="rounded border me-2" height="36">
                  <span class="text-muted small">Current logo uploaded</span>
                </div>
              <% } %>
            </div>
            <div class="col-md-6">
              <label class="form-label">Authorized Signature / Stamp <small class="text-muted">(JPG/PNG, Max 2MB)</small></label>
              <input type="file" class="form-control" name="signature" accept=".jpg,.jpeg,.png,.webp">
              <% if (firm && firm.signature_path) { %>
                <div class="mt-2 d-flex align-items-center">
                  <img src="<%= firm.signature_path %>" alt="Current Signature" class="rounded border me-2" height="36">
                  <span class="text-muted small">Current signature uploaded</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Section 2: Address & State Details -->
          <h5 class="fw-semibold text-primary border-bottom pb-2 mb-3">2. Address & Place of Supply</h5>
          <div class="row g-3 mb-4">
            <div class="col-12">
              <label for="address" class="form-label">Street Address</label>
              <textarea class="form-control" id="address" name="address" rows="2" placeholder="e.g. Shop No. 4, MG Road, Market Area"><%= firm ? (firm.address || '') : '' %></textarea>
            </div>
            <div class="col-md-4">
              <label for="city" class="form-label">City / Town</label>
              <input type="text" class="form-control" id="city" name="city" placeholder="e.g. Mumbai" value="<%= firm ? (firm.city || '') : '' %>">
            </div>
            <div class="col-md-4">
              <label for="stateSelect" class="form-label">State</label>
              <select class="form-select" id="stateSelect" name="state">
                <option value="">-- Select State --</option>
                <% gstStates.forEach(st => { %>
                  <option value="<%= st.name %>" data-code="<%= st.code %>" <%= (firm && firm.state === st.name) ? 'selected' : '' %>>
                    <%= st.code %> - <%= st.name %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-2">
              <label for="stateCodeInput" class="form-label">State Code</label>
              <input type="text" class="form-control font-monospace" id="stateCodeInput" name="state_code" placeholder="e.g. 27" value="<%= firm ? (firm.state_code || '') : '' %>" readonly>
            </div>
            <div class="col-md-2">
              <label for="pincode" class="form-label">Pincode</label>
              <input type="text" class="form-control" id="pincode" name="pincode" placeholder="e.g. 400001" value="<%= firm ? (firm.pincode || '') : '' %>">
            </div>
          </div>

          <!-- Section 3: Bank Details & UPI (For Invoices) -->
          <h5 class="fw-semibold text-primary border-bottom pb-2 mb-3">3. Bank Account & UPI Details (Printed on Invoices)</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="bank_name" class="form-label">Bank Name</label>
              <input type="text" class="form-control" id="bank_name" name="bank_name" placeholder="e.g. State Bank of India" value="<%= firm ? (firm.bank_name || '') : '' %>">
            </div>
            <div class="col-md-4">
              <label for="bank_account_no" class="form-label">Bank Account Number</label>
              <input type="text" class="form-control font-monospace" id="bank_account_no" name="bank_account_no" placeholder="e.g. 987654321098" value="<%= firm ? (firm.bank_account_no || '') : '' %>">
            </div>
            <div class="col-md-4">
              <label for="bank_ifsc" class="form-label">IFSC Code</label>
              <input type="text" class="form-control font-monospace text-uppercase" id="bank_ifsc" name="bank_ifsc" placeholder="e.g. SBIN0001234" value="<%= firm ? (firm.bank_ifsc || '') : '' %>">
            </div>
            <div class="col-md-6">
              <label for="bank_branch" class="form-label">Branch Name</label>
              <input type="text" class="form-control" id="bank_branch" name="bank_branch" placeholder="e.g. Main Branch, Mumbai" value="<%= firm ? (firm.bank_branch || '') : '' %>">
            </div>
            <div class="col-md-6">
              <label for="upi_id" class="form-label">UPI ID / VPA</label>
              <input type="text" class="form-control font-monospace" id="upi_id" name="upi_id" placeholder="e.g. business@okaxis" value="<%= firm ? (firm.upi_id || '') : '' %>">
            </div>
          </div>

          <!-- Section 4: Invoice Terms -->
          <h5 class="fw-semibold text-primary border-bottom pb-2 mb-3">4. Default Invoice Terms & Conditions</h5>
          <div class="row g-3 mb-4">
            <div class="col-12">
              <textarea class="form-control" id="terms" name="terms" rows="2" placeholder="e.g. 1. Goods once sold will not be taken back. 2. Interest @ 18% p.a. will be charged if payment is delayed."><%= firm ? (firm.terms || '') : '1. Goods once sold will not be taken back. 2. Subject to local jurisdiction.' %></textarea>
            </div>
          </div>

          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="is_default" name="is_default" value="1" <%= (firm && firm.is_default) ? 'checked' : '' %>>
            <label class="form-check-label fw-medium" for="is_default">
              Set as primary / default business firm
            </label>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/firms" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 shadow-sm">
              <i class="bi bi-check2-circle me-1"></i> <%= firm ? 'Save Changes' : 'Create Firm' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // Sync state select with state code input
  const stateSelect = document.getElementById('stateSelect');
  const stateCodeInput = document.getElementById('stateCodeInput');
  if (stateSelect && stateCodeInput) {
    stateSelect.addEventListener('change', function() {
      const selected = stateSelect.options[stateSelect.selectedIndex];
      stateCodeInput.value = selected ? (selected.dataset.code || '') : '';
    });
  }
</script>

<%- include('../partials/footer') %>
