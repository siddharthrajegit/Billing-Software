<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1">My Business Firms</h3>
    <p class="text-muted small mb-0">Manage multiple business entities, companies, and branches</p>
  </div>
  <a href="/firms/create" class="btn btn-primary shadow-sm">
    <i class="bi bi-plus-circle me-1"></i> Register New Firm
  </a>
</div>

<div class="row g-4">
  <% if (firms && firms.length > 0) { %>
    <% firms.forEach(f => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 position-relative <%= (activeFirm && activeFirm.id === f.id) ? 'border border-2 border-primary' : '' %>">
          <div class="card-body p-4">
            <!-- Badges -->
            <div class="d-flex justify-content-between align-items-start mb-3">
              <% if (f.logo_path) { %>
                <img src="<%= f.logo_path %>" alt="<%= f.name %>" class="rounded border p-1 bg-white" style="width: 48px; height: 48px; object-fit: contain;">
              <% } else { %>
                <div class="bg-light text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.4rem;">
                  <i class="bi bi-buildings"></i>
                </div>
              <% } %>

              <div class="d-flex flex-column align-items-end gap-1">
                <% if (activeFirm && activeFirm.id === f.id) { %>
                  <span class="badge bg-primary">Active Now</span>
                <% } %>
                <% if (f.is_default) { %>
                  <span class="badge bg-secondary">Default</span>
                <% } %>
              </div>
            </div>

            <h5 class="fw-bold text-dark mb-1"><%= f.name %></h5>
            
            <% if (f.gstin) { %>
              <div class="small font-monospace text-primary mb-2">GSTIN: <%= f.gstin %></div>
            <% } else { %>
              <div class="small text-muted mb-2">Non-GST Firm</div>
            <% } %>

            <div class="text-muted small mb-3">
              <% if (f.phone) { %><div><i class="bi bi-telephone me-1"></i> <%= f.phone %></div><% } %>
              <% if (f.email) { %><div><i class="bi bi-envelope me-1"></i> <%= f.email %></div><% } %>
              <% if (f.city || f.state) { %>
                <div><i class="bi bi-geo-alt me-1"></i> <%= [f.city, f.state].filter(Boolean).join(', ') %></div>
              <% } %>
            </div>

            <hr class="my-3">

            <!-- Actions -->
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
              <div>
                <% if (!activeFirm || activeFirm.id !== f.id) { %>
                  <form action="/firms/switch/<%= f.id %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-arrow-repeat me-1"></i> Switch to This
                    </button>
                  </form>
                <% } %>
              </div>

              <div class="d-flex gap-1">
                <a href="/firms/edit/<%= f.id %>" class="btn btn-sm btn-light" title="Edit Details">
                  <i class="bi bi-pencil"></i>
                </a>

                <% if (!f.is_default) { %>
                  <form action="/firms/default/<%= f.id %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-light" title="Make Default">
                      <i class="bi bi-star"></i>
                    </button>
                  </form>
                <% } %>

                <% if (firms.length > 1) { %>
                  <form action="/firms/delete/<%= f.id %>" method="POST" class="d-inline form-delete-confirm" data-confirm-message="Are you sure you want to delete this firm and all associated bills?">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Firm">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>
</div>

<%- include('../partials/footer') %>
